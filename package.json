{
  "name": "eladmin-web",
  "version": "3.0.0",
  "type": "module",
  "description": "EL-ADMIN 前端源码（Vue 3 + Vite + Element Plus）",
  "author": "Zheng Jie",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview --port 8013",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:ci": "eslint src --max-warnings=0",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run lint:ci && npm run test:unit && npm run build && npm run check:bundle",
    "svgo": "svgo -f src/assets/icons/svg --config=src/assets/icons/svgo.yml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elunez/eladmin-web.git"
  },
  "bugs": {
    "url": "https://github.com/elunez/eladmin/issues"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.21.0",
    "codemirror": "^5.65.21",
    "cropperjs": "^1.7.0",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.14.7",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "js-cookie": "^3.0.8",
    "jsencrypt": "^3.5.4",
    "md-editor-v3": "^7.1.0",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "qs": "^6.17.0",
    "read-excel-file": "^9.3.14",
    "screenfull": "^6.0.2",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "sass": "^1.106.1",
    "svgo": "^4.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
